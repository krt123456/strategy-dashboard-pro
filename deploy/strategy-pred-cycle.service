[Unit]
Description=Strategy-Pred trusted data and resolution cycle
Documentation=file:/root/strategy-pred/deploy/run_strategy_cycle.sh
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/root/strategy-pred
ConditionPathExists=/root/strategy-pred/.env
ConditionPathExists=/root/strategy-pred/data/betting_journal.db

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/strategy-pred
EnvironmentFile=/root/strategy-pred/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=UTC
ExecStart=/usr/bin/bash /root/strategy-pred/deploy/run_strategy_cycle.sh

# Bound the complete oneshot. Individual network steps also have shorter timeouts.
TimeoutStartSec=45min
TimeoutStopSec=1min
KillMode=control-group
KillSignal=SIGTERM

# Keep the cycle below the resources needed by the rest of the VPS.
MemoryMax=2G
CPUQuota=80%
Nice=10
TasksMax=256
OOMPolicy=stop

# Runtime lock directory and filesystem hardening.
RuntimeDirectory=strategy-pred
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# The selected cycle writes only generated data, reports, and dashboard assets.
ReadWritePaths=/root/strategy-pred/data
ReadWritePaths=/root/strategy-pred/reports
ReadWritePaths=/root/strategy-pred/dashboard
ReadWritePaths=/run/strategy-pred

StandardOutput=journal
StandardError=journal
SyslogIdentifier=strategy-pred-cycle
